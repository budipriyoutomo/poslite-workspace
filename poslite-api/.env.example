# ADR-013: three roles. The API uses the app role (RLS enforced); migrations run as the owner;
# the system role (BYPASSRLS) is only for token lookup and the outbox relay.
DATABASE_URL=postgresql+asyncpg://poslite_app:poslite@localhost:5432/poslite
MIGRATION_DATABASE_URL=postgresql+asyncpg://poslite:poslite@localhost:5432/poslite
SYSTEM_DATABASE_URL=postgresql+asyncpg://poslite_system:poslite@localhost:5432/poslite
REDIS_URL=redis://localhost:6379/0
# ADR-027 rate limits: memory = one process (dev); redis when several API workers run
RATE_LIMIT_BACKEND=memory
MIN_APP_VERSION=0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]
# Integration tests (tests/integration) use a separate local database; created by `make db-setup`.
TEST_DATABASE_URL=postgresql+asyncpg://poslite_app:poslite@localhost:5432/poslite_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://poslite:poslite@localhost:5432/poslite_test
TEST_SYSTEM_DATABASE_URL=postgresql+asyncpg://poslite_system:poslite@localhost:5432/poslite_test
# ADR-017/018: payment gateway (only "fake" until a vendor is chosen), webhook secret, the URL the
# gateway and browsers reach this API at, and the subscription price per outlet per month (Rupiah).
PAYMENT_GATEWAY=fake
GATEWAY_SECRET=dev-gateway-secret
PUBLIC_API_URL=http://localhost:8000
PRICE_PER_OUTLET=150000
# ADR-021: product images. The database stores only object keys (<tenant>/products/<ulid>.jpg);
# image URLs = MEDIA_PUBLIC_BASE_URL + "/" + key, so switching S3 vendors = copy the objects and
# change these values. "local" (default) keeps files in MEDIA_LOCAL_DIR, served by the API at /media.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=var/media
# IDCloudHost Object Storage (S3-compatible). Uncomment and fill in to use it:
# MEDIA_STORAGE=s3
# S3_ENDPOINT_URL=https://is3.cloudhost.id
# S3_REGION=SouthJkt-a
# S3_BUCKET=poslite-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_OBJECT_ACL=public-read
# MEDIA_PUBLIC_BASE_URL=https://is3.cloudhost.id/poslite-media
