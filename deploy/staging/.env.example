# Copy to .env (never commit it). Generate every password/secret with: openssl rand -hex 24
# (hex only — the database passwords are placed inside connection URLs).

# Domains. DNS A record of API_DOMAIN → this VPS; POS_DOMAIN, ADMIN_DOMAIN and OPERATOR_DOMAIN → Vercel.
API_DOMAIN=api-staging.example.id
POS_DOMAIN=pos-staging.example.id
ADMIN_DOMAIN=admin-staging.example.id
OPERATOR_DOMAIN=operator-staging.example.id
ACME_EMAIL=ops@example.id

# PostgreSQL: superuser (initdb only) and the three POSLite roles (ADR-013).
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
SYSTEM_DB_PASSWORD=

# ADR-017: staging uses the fake gateway until a vendor is chosen. Its checkout page
# (/api/v1/gateway/fake/pay/…) marks charges paid for anyone — never use it in production.
GATEWAY_SECRET=
PRICE_PER_OUTLET=150000

# Devices below this version get 426 and must update (X-App-Version = poslite-web package.json).
MIN_APP_VERSION=0.0.0

# ADR-021: product images. "local" keeps them in the `media` volume, served by the API at /media.
MEDIA_STORAGE=local
# IDCloudHost Object Storage (S3-compatible) instead:
# MEDIA_STORAGE=s3
# S3_ENDPOINT_URL=https://is3.cloudhost.id
# S3_REGION=SouthJkt-a
# S3_BUCKET=poslite-staging-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_OBJECT_ACL=public-read
# MEDIA_PUBLIC_BASE_URL=https://is3.cloudhost.id/poslite-staging-media
